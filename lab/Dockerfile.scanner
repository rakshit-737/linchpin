# Scanner for the CI lab: Debian's nmap package, run as an unprivileged user (TCP connect scans).
FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends nmap \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 10001 scanner
USER scanner
ENTRYPOINT ["nmap"]
